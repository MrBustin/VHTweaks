{
  "descriptions": {
    "Healthy_Elixir": [
      {
        "text": "Enhances the "
      },
      {
        "text": "Healthiness ",
        "color": "#7DF587"
      },
      {
        "text": "of your "
      },
      {
        "text": "Vault Potion ",
        "color": "aqua"
      },
      {
        "text": ", making it also heal an additional percentage of your "
      },
      {
        "text": "max health",
        "color": "#8EEDD9"
      },
      {
        "text": ".\n\nDepending on the tier, the amount restored will be modified: "
      },
      {
        "text": "\nVial: 50% reduction"
      },
      {
        "text": "\nPotion: 25% reduction"
      },
      {
        "text": "\nMixture: 0% reduction"
      },
      {
        "text": "\nBrew: 50% increase"
      },
      {
        "text": ".\n\n1 "
      },
      {
        "text": "+20%",
        "color": "#7DF587"
      },
      {
        "text": "\n\n2 "
      },
      {
        "text": "+30%",
        "color": "#7DF587"
      },
      {
        "text": "\n\n3 "
      },
      {
        "text": "+40%",
        "color": "#7DF587"
      },
      {
        "text": "\n\n"
      },
      {
        "text": "\n\n"
      },
      {
        "text": "Overlevels of the "
      },
      {
        "text": "Healthy Elixir",
        "color": "gold"
      },
      {
        "text": " talent "
      },
      {
        "text": "add "
      },
      {
        "text": "+3% max health restored",
        "color": "#7DF587"
      }
    ],
    "Momentum_Engine": [
      {
        "text": "While moving, builds up stacks of "
      },
      {
        "text": "Momentum ",
        "color": "#E9C375"
      },
      {
        "text": "increasing your "
      },
      {
        "text": "Movement Speed",
        "color": "#f6cd0e"
      },
      {
        "text": ". When at the maximum stacks, the next melee strike consumes all stacks to trigger a guaranteed "
      },
      {
        "text": "Shocking Hit ",
        "color": "#ffeb07"
      },
      {
        "text": "with a modified radius and knockback. Remaining stationary or performing a melee strike will remove stacks."
      },
      {
        "text": ".\n\n1 "
      },
      {
        "text": "5 max stacks, 4% Movement Speed per stack, stacking every 4 seconds. 6 Radius with 120% Knockback.",
        "color": "#C7FFE7"
      },
      {
        "text": "\n\n2 "
      },
      {
        "text": "+5 max stacks, 4% Movement Speed per stack, stacking every 3.5 seconds. 7 Radius with 140% Knockback",
        "color": "#C7FFE7"
      },
      {
        "text": "\n\n3 "
      },
      {
        "text": "5 max stacks, 4% Movement Speed per stack, stacking every 3 seconds. 8 Radius with 160% Knockback.",
        "color": "#C7FFE7"
      },
      {
        "text": "\n\n"
      },
      {
        "text": "\n\n"
      },
      {
        "text": "Overlevels of the "
      },
      {
        "text": "Momentum Engine",
        "color": "gold"
      },
      {
        "text": " talent "
      },
      {
        "text": "add "
      },
      {
        "text": "+0.1 second charge reduction and increased knock and size",
        "color": "#C7FFE7"
      }
